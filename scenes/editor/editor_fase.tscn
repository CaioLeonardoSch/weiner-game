grow_vertical = 2

[node name="Texto" type="RichTextLabel" parent="UI/Ajuda"]
layout_mode = 2
bbcode_enabled = true
text = "[b]Editor de fases — atalhos[/b]
[table=2][cell][color=#ffd980]Câmera[/color][/cell][cell] [/cell][cell]WASD / setas    [/cell][cell][color=#cccccc]mover[/color][/cell][cell]Roda do mouse    [/cell][cell][color=#cccccc]zoom[/color][/cell][cell]Botão do meio    [/cell][cell][color=#cccccc]girar (com Shift: arrastar)[/color][/cell][cell]Espaço + botão esquerdo    [/cell][cell][color=#cccccc]girar a vista em qualquer ferramenta (com Shift: arrastar)[/color][/cell][cell]Home    [/cell][cell][color=#cccccc]centralizar no início do cachorro[/color][/cell][cell]V    [/cell][cell][color=#cccccc]visão: livre / isométrica (vista de cima, travada)[/color][/cell][cell][color=#ffd980]Cursor (Esc)[/color][/cell][cell] [/cell][cell]Clique    [/cell][cell][color=#cccccc]selecionar; arraste um objeto para mover[/color][/cell][cell]Arrastar no vazio    [/cell][cell][color=#cccccc]girar a vista (com Shift: arrastar)[/color][/cell][cell]Del / Ctrl+D / Ctrl+C    [/cell][cell][color=#cccccc]apagar / duplicar / copiar o objeto selecionado[/color][/cell][cell][color=#ffd980]Terreno (tile escolhido na paleta)[/color][/cell][cell] [/cell][cell]1 a 5    [/cell][cell][color=#cccccc]ferramentas: Pincel, Trocar, Linha, Retângulo, Balde (barra em cima da vista)[/color][/cell][cell]Ctrl + roda  ou  [ e ]    [/cell][cell][color=#cccccc]tamanho do pincel (1×1, 2×2, 3×3...)[/color][/cell][cell]Clique esquerdo    [/cell][cell][color=#cccccc]Pincel: colocar em cima/ao lado do bloco apontado; arraste para pintar[/color][/cell][cell]Clique direito    [/cell][cell][color=#cccccc]apagar (arraste para apagar vários)[/color][/cell][cell]Shift + clique, clique    [/cell][cell][color=#cccccc]linha: o 1º clique marca o começo, a prévia vai até o mouse, o 2º confirma (Shift ainda apertado: continua dali)[/color][/cell][cell]Ctrl + arrastar    [/cell][cell][color=#cccccc]retângulo: colocar (esq.) ou apagar (dir.)[/color][/cell][cell]Alt + clique    [/cell][cell][color=#cccccc]balde: troca a mancha inteira de blocos iguais (ou preenche o vazio da camada)[/color][/cell][cell]Q / E    [/cell][cell][color=#cccccc]girar o tile (rampas sobem para a seta)[/color][/cell][cell]PgUp / PgDn  ou  R / F    [/cell][cell][color=#cccccc]camada da grade (onde colocar quando não há bloco)[/color][/cell][cell][color=#ffd980]Objetos (objeto escolhido na paleta)[/color][/cell][cell] [/cell][cell]Clique esquerdo / direito    [/cell][cell][color=#cccccc]colocar / apagar[/color][/cell][cell]Q / E    [/cell][cell][color=#cccccc]girar 45° (com Shift: 15°)[/color][/cell][cell]Shift + clique, clique    [/cell][cell][color=#cccccc]linha de objetos (cercas, árvores, pedras em fila)[/color][/cell][cell]Ctrl + arrastar    [/cell][cell][color=#cccccc]espalhar cópias sorteadas (pincel de floresta)[/color][/cell][cell]Alt    [/cell][cell][color=#cccccc]posição livre (sem encaixar no centro da célula)[/color][/cell][cell][color=#ffd980]Trecho (T): pedaços do mapa[/color][/cell][cell] [/cell][cell]Arrastar    [/cell][cell][color=#cccccc]marcar um retângulo (todas as camadas: blocos e objetos)[/color][/cell][cell]Ctrl+C / Ctrl+X / Del    [/cell][cell][color=#cccccc]copiar / recortar / apagar o trecho[/color][/cell][cell]Painel da direita    [/cell][cell][color=#cccccc]salvar o trecho como módulo (aparece na paleta, em Módulos)[/color][/cell][cell][color=#ffd980]Colar (Ctrl+V, ou um módulo da paleta)[/color][/cell][cell] [/cell][cell]Clique    [/cell][cell][color=#cccccc]colar aqui (continua colando; Esc sai)[/color][/cell][cell]Q / E    [/cell][cell][color=#cccccc]girar 90°[/color][/cell][cell]PgUp / PgDn  ou  R / F    [/cell][cell][color=#cccccc]subir / descer o que vai ser colado[/color][/cell][cell][color=#ffd980]Ligar mecanismos (L)[/color][/cell][cell] [/cell][cell]Clique, clique    [/cell][cell][color=#cccccc]liga as duas peças (placa → portão): a segunda fica com a cor da primeira; clicar num par já ligado desliga[/color][/cell][cell]Shift + clique    [/cell][cell][color=#cccccc]liga e continua com a mesma origem[/color][/cell][cell]Clique direito    [/cell][cell][color=#cccccc]solta a peça de todas as ligações[/color][/cell][cell][color=#ffd980]Paleta[/color][/cell][cell] [/cell][cell]Título da seção    [/cell][cell][color=#cccccc]recolhe / abre a seção[/color][/cell][cell]Recentes    [/cell][cell][color=#cccccc]os últimos itens usados[/color][/cell][cell]Busca    [/cell][cell][color=#cccccc]digite para filtrar tiles, objetos e módulos[/color][/cell][cell][color=#ffd980]Geral[/color][/cell][cell] [/cell][cell]Ctrl+Z / Ctrl+Y    [/cell][cell][color=#cccccc]desfazer / refazer[/color][/cell][cell]Ctrl+S    [/cell][cell][color=#cccccc]salvar (Salvar como: arquivo novo com o nome da fase)[/color][/cell][cell]F1    [/cell][cell][color=#cccccc]testar a fase (F1 no jogo volta para cá)[/color][/cell][cell]F2    [/cell][cell][color=#cccccc]testar daqui: o cachorro começa onde está o cursor[/color][/cell][cell]G    [/cell][cell][color=#cccccc]conta-gotas: pega o tile ou objeto sob o cursor[/color][/cell][cell]F3    [/cell][cell][color=#cccccc]liga/desliga o pixelado[/color][/cell][cell]M    [/cell][cell][color=#cccccc]minimapa (clique ou arraste nele para levar a câmera)[/color][/cell][cell]Tab    [/cell][cell][color=#cccccc]esconder / mostrar os painéis (ver o mapa inteiro)[/color][/cell][cell]F11    [/cell][cell][color=#cccccc]tela cheia / janela[/color][/cell][/table]
Esc ou H fecha esta janela."
fit_content = false
scroll_active = true

[node name="Confirmar" type="ConfirmationDialog" parent="UI"]
unique_name_in_owner = true
title = "Alterações não salvas"
ok_button_text = "Continuar"
cancel_button_text = "Cancelar"

[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/jogo.gd" id="1_jogo"]
[ext_resource type="PackedScene" path="res://scenes/ambiente.tscn" id="2_ambiente"]
[ext_resource type="PackedScene" path="res://scenes/dachshund.tscn" id="3_dachshund"]
[ext_resource type="Script" path="res://scripts/camera_controller.gd" id="4_camera"]
[ext_resource type="PackedScene" path="res://scenes/contorno_pixel.tscn" id="5_contorno"]
[ext_resource type="Script" path="res://scripts/indicador_equilibrio.gd" id="6_equilibrio"]
[ext_resource type="Script" path="res://scripts/ui/area_segura.gd" id="7_area"]

[sub_resource type="SphereShape3D" id="Forma_braco"]
radius = 0.2

[node name="Jogo" type="Node3D"]
script = ExtResource("1_jogo")

[node name="Ambiente" parent="." instance=ExtResource("2_ambiente")]

[node name="Dachshund" parent="." instance=ExtResource("3_dachshund")]

[node name="CameraController" type="Node3D" parent="."]
script = ExtResource("4_camera")

[node name="BracoCamera" type="SpringArm3D" parent="CameraController"]
collision_mask = 1
shape = SubResource("Forma_braco")
spring_length = 4.0
margin = 0.1

[node name="Camera3D" type="Camera3D" parent="CameraController"]
current = true

[node name="ContornoPixel" parent="CameraController/Camera3D" instance=ExtResource("5_contorno")]

[node name="HUD" type="CanvasLayer" parent="."]

[node name="Area" type="Control" parent="HUD"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("7_area")

[node name="Aviso" type="Label" parent="HUD/Area"]
anchor_right = 1.0
offset_top = 90.0
offset_bottom = 150.0
theme_override_font_sizes/font_size = 34
text = "Nova perspectiva!"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Mensagem" type="Label" parent="HUD/Area"]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 12
theme_override_font_sizes/font_size = 52
text = "Fase concluída!"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Equilibrio" type="Control" parent="HUD/Area"]
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -160.0
offset_top = -64.0
offset_right = 160.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
script = ExtResource("6_equilibrio")
